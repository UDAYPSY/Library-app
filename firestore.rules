rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLibraryOwner(libraryId) {
      return request.auth != null && request.auth.uid == libraryId;
    }

    // Global Staff Directory for seamless multi-device staff lookup by phone or email
    match /staff_directory/{identifier} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /libraries/{libraryId} {
      // Allow public read on library profile for public QR admission portal & seat verification
      allow read: if true;
      allow write: if isLibraryOwner(libraryId);

      match /students/{studentId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.phone is string;
        allow delete: if isLibraryOwner(libraryId);
      }

      match /seats/{seatId} {
        allow read, write: if request.auth != null;
      }

      match /payments/{paymentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0;
        allow update: if false; // Immutable ledger: payments cannot be altered
        allow delete: if isLibraryOwner(libraryId); // Only library owner can wipe on permanent account deletion
      }

      match /expenses/{expenseId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if isLibraryOwner(libraryId);
      }

      match /settings/{docId} {
        allow read: if true;
        allow write: if isLibraryOwner(libraryId);
      }

      match /staff/{staffId} {
        allow read: if request.auth != null;
        allow write: if isLibraryOwner(libraryId);
      }

      match /branches/{branchId} {
        allow read: if request.auth != null;
        allow write: if isLibraryOwner(libraryId);
      }

      match /backups/{backupId} {
        allow read, write: if isLibraryOwner(libraryId);
      }

      match /registration_requests/{requestId} {
        // Prospective students can submit self-registration via public QR / link
        allow create: if request.resource.data.phone is string 
                      && (
                        (request.resource.data.student_name is string && request.resource.data.student_name.size() > 0) ||
                        (request.resource.data.name is string && request.resource.data.name.size() > 0)
                      );
        // Only authenticated library accounts can view, approve, update, or reject requests
        allow read, update, delete: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
