rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLibraryOwner(libraryId) {
      return request.auth != null && request.auth.uid == libraryId;
    }

    match /libraries/{libraryId} {
      // Allow public read on library profile for public QR admission portal & seat verification
      allow read: if true;
      allow write: if isLibraryOwner(libraryId);

      match /students/{studentId} {
        allow read: if isLibraryOwner(libraryId);
        allow create, update: if isLibraryOwner(libraryId)
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.phone is string;
        allow delete: if isLibraryOwner(libraryId);
      }

      match /seats/{seatId} {
        allow read, write: if isLibraryOwner(libraryId);
      }

      match /payments/{paymentId} {
        allow read: if isLibraryOwner(libraryId);
        allow create: if isLibraryOwner(libraryId)
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, write: if isLibraryOwner(libraryId);
      }

      match /settings/{docId} {
        allow read: if true;
        allow write: if isLibraryOwner(libraryId);
      }

      match /staff/{staffId} {
        allow read, write: if isLibraryOwner(libraryId);
      }

      match /branches/{branchId} {
        allow read, write: if isLibraryOwner(libraryId);
      }

      match /backups/{backupId} {
        allow read, write: if isLibraryOwner(libraryId);
      }

      match /registration_requests/{requestId} {
        // Prospective students can submit self-registration via public QR / link
        allow create: if request.resource.data.phone is string 
                      && (
                        (request.resource.data.student_name is string && request.resource.data.student_name.size() > 0) ||
                        (request.resource.data.name is string && request.resource.data.name.size() > 0)
                      );
        // Only library owner can view, approve, update, or reject requests
        allow read, update, delete: if isLibraryOwner(libraryId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
